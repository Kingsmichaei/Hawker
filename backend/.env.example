# PayPal sandbox app: developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
# Optional: webhook id for PAYMENT.CAPTURE.COMPLETED (backup if the buyer closes the tab mid-payment)
PAYPAL_WEBHOOK_ID=

# Free key from aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Password for the /seller dashboard
SELLER_TOKEN=change-me
DATABASE_URL=sqlite:///./hawker.db
CORS_ORIGINS=http://localhost:5173